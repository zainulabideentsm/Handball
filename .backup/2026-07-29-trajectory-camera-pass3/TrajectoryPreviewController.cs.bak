using UnityEngine;

[DisallowMultipleComponent]
[RequireComponent(typeof(MeshFilter), typeof(MeshRenderer))]
[DefaultExecutionOrder(50)]
public sealed class TrajectoryPreviewController : MonoBehaviour
{
    // Fixed mesh buffer capacity (hard upper bound for maximumVisibleChevrons).
    private const int ChevronCapacity = 28;
    private const int VerticesPerChevron = 8; // two stroke-quads per chevron (double-chevron/"V")
    private const int TrianglesPerChevron = 4;

    private const float RebuildOriginThresholdSqr = 0.0009f; // ~3cm
    private const float RebuildDirectionDotThreshold = 0.99995f; // ~0.57 degrees
    private const float RebuildSpeedThreshold = 0.01f;

    // How strongly chevron world-size compensates for camera-distance perspective falloff.
    // 1 = perfectly constant on-screen size, 0 = full natural perspective. A high value here
    // (rather than 1) intentionally leaves a small, acceptable perspective reduction.
    private const float PerspectiveCompensation = 0.82f;

    [Header("References")]
    [SerializeField] private PlayerBallPickup ballPickup;
    [SerializeField] private PlayerAimController aimController;
    [SerializeField] private Transform throwOrigin;

    [Header("Throw")]
    [SerializeField, Min(0f)]
    private float launchSpeed = 12f;

    [Header("Prediction")]
    [SerializeField, Range(10, 100)]
    private int maximumPointCount = 60;

    [SerializeField, Range(0.01f, 0.15f)]
    private float simulationStep = 0.05f;

    [SerializeField, Range(0.5f, 6f)]
    private float maximumSimulationTime = 4f;

    [Header("Collision")]
    [Tooltip("Select Ground, Boundaries and Hoop. Exclude Player and Ball.")]
    [SerializeField]
    private LayerMask collisionMask = 896; // Ground | Boundaries | Hoop

    [SerializeField, Min(0.01f)]
    private float previewBallRadius = 0.12f;

    [SerializeField, Min(0f)]
    private float collisionSkin = 0.01f;

    [Header("Chevron Visual")]
    [SerializeField]
    private Material chevronMaterial;

    [Tooltip("Base world-space size of each flat chevron.")]
    [SerializeField, Min(0.01f)]
    private float chevronSize = 0.30f;

    [Tooltip("World-space arc-length distance between chevrons.")]
    [SerializeField, Min(0.05f)]
    private float chevronSpacing = 0.42f;

    [Tooltip("World-space gap left empty at the start so chevrons don't intersect the player or held ball.")]
    [SerializeField, Min(0f)]
    private float startSkipDistance = 0.55f;

    [Tooltip("World-space gap trimmed off the end, near the predicted landing point.")]
    [SerializeField, Min(0f)]
    private float endSkipDistance = 0.10f;

    [Tooltip("Overall chevron transparency (multiplies the material's alpha).")]
    [SerializeField, Range(0f, 1f)]
    private float chevronOpacity = 0.85f;

    [Tooltip("Chevron flow speed toward the target, in world units per second.")]
    [SerializeField]
    private float flowSpeed = 1.0f;

    [Tooltip("Maximum number of chevrons visible at once (mobile performance cap).")]
    [SerializeField, Range(4, ChevronCapacity)]
    private int maximumVisibleChevrons = 24;

    [Tooltip("Optional roll correction (degrees) around camera.forward, only needed if a future chevron sprite's authored forward axis doesn't match screenTangent.")]
    [SerializeField]
    private float chevronRotationOffsetDegrees = 0f;

    [Header("Rendering")]
    [Tooltip("Camera used to orient chevrons. Falls back to Camera.main when empty.")]
    [SerializeField]
    private Camera aimCamera;

    [HideInInspector]
    [SerializeField]
    [System.Obsolete("Unused since the LineRenderer-based texture scroll was replaced by generated chevron meshes. Kept only so old Inspector values are not lost.")]
    private float tilesPerWorldUnit = 2f;

    public float LaunchSpeed => launchSpeed;

    private MeshFilter meshFilter;
    private MeshRenderer meshRenderer;
    private Mesh chevronMesh;
    private MaterialPropertyBlock propertyBlock;

    private Vector3[] fineSamplePositions;
    private float[] fineCumulativeDistance;
    private int fineSampleCount;
    private float totalLength;
    private bool hasValidPath;

    private Vector3[] chevronVertices;

    private bool hasCachedSimulation;
    private Vector3 lastOrigin;
    private Vector3 lastDirection;
    private float lastLaunchSpeed;

    private Camera cachedCamera;

    private void Awake()
    {
        meshFilter = GetComponent<MeshFilter>();
        meshRenderer = GetComponent<MeshRenderer>();

        chevronMesh = new Mesh { name = "TrajectoryChevronMesh" };
        chevronMesh.MarkDynamic();
        meshFilter.sharedMesh = chevronMesh;

        if (chevronMaterial != null)
        {
            meshRenderer.sharedMaterial = chevronMaterial;
        }

        meshRenderer.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.Off;
        meshRenderer.receiveShadows = false;
        meshRenderer.lightProbeUsage = UnityEngine.Rendering.LightProbeUsage.Off;
        meshRenderer.reflectionProbeUsage = UnityEngine.Rendering.ReflectionProbeUsage.Off;
        meshRenderer.enabled = false;

        fineSamplePositions = new Vector3[maximumPointCount];
        fineCumulativeDistance = new float[maximumPointCount];

        chevronVertices = new Vector3[ChevronCapacity * VerticesPerChevron];

        BuildStaticTriangleBuffer();

        propertyBlock = new MaterialPropertyBlock();
        ApplyOpacity();

        cachedCamera = aimCamera != null ? aimCamera : Camera.main;
    }

    private void BuildStaticTriangleBuffer()
    {
        var triangles = new int[ChevronCapacity * TrianglesPerChevron * 3];

        for (int i = 0; i < ChevronCapacity; i++)
        {
            int vertexBase = i * VerticesPerChevron;
            int triangleBase = i * TrianglesPerChevron * 3;

            // Right arm quad (vertices 0-3).
            triangles[triangleBase + 0] = vertexBase + 0;
            triangles[triangleBase + 1] = vertexBase + 1;
            triangles[triangleBase + 2] = vertexBase + 2;
            triangles[triangleBase + 3] = vertexBase + 0;
            triangles[triangleBase + 4] = vertexBase + 2;
            triangles[triangleBase + 5] = vertexBase + 3;

            // Left arm quad (vertices 4-7).
            triangles[triangleBase + 6] = vertexBase + 4;
            triangles[triangleBase + 7] = vertexBase + 5;
            triangles[triangleBase + 8] = vertexBase + 6;
            triangles[triangleBase + 9] = vertexBase + 4;
            triangles[triangleBase + 10] = vertexBase + 6;
            triangles[triangleBase + 11] = vertexBase + 7;
        }

        chevronMesh.SetVertices(chevronVertices);
        chevronMesh.SetTriangles(triangles, 0);
    }

    private void ApplyOpacity()
    {
        if (meshRenderer == null || propertyBlock == null)
        {
            return;
        }

        meshRenderer.GetPropertyBlock(propertyBlock);
        propertyBlock.SetColor("_BaseColor", new Color(1f, 1f, 1f, chevronOpacity));
        meshRenderer.SetPropertyBlock(propertyBlock);
    }

    // Runs after ThirdPersonCameraFollow.LateUpdate (default order 0) via [DefaultExecutionOrder(50)],
    // so chevron orientation uses this frame's final camera transform with no lag.
    private void LateUpdate()
    {
        bool shouldShow =
            ballPickup != null &&
            aimController != null &&
            throwOrigin != null &&
            ballPickup.HasBall &&
            aimController.IsAiming;

        if (!shouldShow)
        {
            HideTrajectory();
            return;
        }

        RebuildSimulationIfNeeded();

        if (!hasValidPath)
        {
            HideTrajectory();
            return;
        }

        AnimateChevrons();
    }

    private void RebuildSimulationIfNeeded()
    {
        Vector3 origin = throwOrigin.position;
        Vector3 direction = aimController.AimDirection.normalized;
        float speed = launchSpeed;

        bool needsRebuild =
            !hasCachedSimulation ||
            (origin - lastOrigin).sqrMagnitude > RebuildOriginThresholdSqr ||
            Vector3.Dot(direction, lastDirection) < RebuildDirectionDotThreshold ||
            Mathf.Abs(speed - lastLaunchSpeed) > RebuildSpeedThreshold;

        if (!needsRebuild)
        {
            return;
        }

        lastOrigin = origin;
        lastDirection = direction;
        lastLaunchSpeed = speed;
        hasCachedSimulation = true;

        SimulateTrajectory(origin, direction, speed);
    }

    // Ballistic prediction always starts at throwOrigin.position — never this GameObject's
    // transform.position, which may sit anywhere in the scene and must not affect the path.
    private void SimulateTrajectory(Vector3 startPosition, Vector3 direction, float speed)
    {
        Vector3 initialVelocity = direction * speed;
        Vector3 gravity = Physics.gravity;

        fineSamplePositions[0] = startPosition;
        fineCumulativeDistance[0] = 0f;

        Vector3 previousPosition = startPosition;

        int usedPointCount = 1;
        float simulationTime = simulationStep;
        float totalDistance = 0f;

        while (usedPointCount < maximumPointCount &&
               simulationTime <= maximumSimulationTime)
        {
            Vector3 nextPosition =
                startPosition +
                initialVelocity * simulationTime +
                0.5f * gravity * simulationTime * simulationTime;

            Vector3 segment = nextPosition - previousPosition;
            float segmentDistance = segment.magnitude;

            if (segmentDistance > 0.0001f)
            {
                Vector3 segmentDirection = segment / segmentDistance;

                if (Physics.SphereCast(
                        previousPosition,
                        previewBallRadius,
                        segmentDirection,
                        out RaycastHit hit,
                        segmentDistance,
                        collisionMask,
                        QueryTriggerInteraction.Ignore))
                {
                    Vector3 hitPosition =
                        hit.point +
                        hit.normal *
                        (previewBallRadius + collisionSkin);

                    totalDistance += Vector3.Distance(previousPosition, hitPosition);

                    fineSamplePositions[usedPointCount] = hitPosition;
                    fineCumulativeDistance[usedPointCount] = totalDistance;

                    usedPointCount++;
                    break;
                }
            }

            totalDistance += segmentDistance;

            fineSamplePositions[usedPointCount] = nextPosition;
            fineCumulativeDistance[usedPointCount] = totalDistance;

            usedPointCount++;
            previousPosition = nextPosition;
            simulationTime += simulationStep;
        }

        fineSampleCount = usedPointCount;
        totalLength = totalDistance;
        hasValidPath = fineSampleCount >= 2 && totalLength > 0.0001f;
    }

    private void SampleAtDistance(float distance, ref int cursor, out Vector3 position, out Vector3 tangent)
    {
        distance = Mathf.Clamp(distance, 0f, totalLength);

        while (cursor < fineSampleCount - 2 && fineCumulativeDistance[cursor + 1] < distance)
        {
            cursor++;
        }

        int indexA = cursor;
        int indexB = Mathf.Min(cursor + 1, fineSampleCount - 1);

        float distanceA = fineCumulativeDistance[indexA];
        float distanceB = fineCumulativeDistance[indexB];
        float segmentLength = distanceB - distanceA;

        float t = segmentLength > 0.0001f
            ? Mathf.Clamp01((distance - distanceA) / segmentLength)
            : 0f;

        position = Vector3.Lerp(fineSamplePositions[indexA], fineSamplePositions[indexB], t);

        Vector3 direction = fineSamplePositions[indexB] - fineSamplePositions[indexA];

        tangent = direction.sqrMagnitude > 0.0001f
            ? direction.normalized
            : transform.forward;
    }

    private void AnimateChevrons()
    {
        float usableLength = totalLength - startSkipDistance - endSkipDistance;

        if (usableLength <= 0.001f)
        {
            HideTrajectory();
            return;
        }

        int visibleCount = Mathf.Clamp(
            Mathf.FloorToInt(usableLength / chevronSpacing) + 1,
            0,
            Mathf.Min(maximumVisibleChevrons, ChevronCapacity)
        );

        if (visibleCount <= 0)
        {
            HideTrajectory();
            return;
        }

        if (cachedCamera == null)
        {
            cachedCamera = aimCamera != null ? aimCamera : Camera.main;
        }

        if (cachedCamera == null)
        {
            HideTrajectory();
            return;
        }

        Transform cameraTransform = cachedCamera.transform;
        Vector3 cameraPosition = cameraTransform.position;

        // Shared plane normal for every chevron this frame — guarantees all chevrons stay
        // perfectly flat/coplanar with the screen, with zero sideways tilt between them.
        Vector3 cameraForward = cameraTransform.forward;

        Quaternion rollCorrection = Mathf.Abs(chevronRotationOffsetDegrees) > 0.0001f
            ? Quaternion.AngleAxis(chevronRotationOffsetDegrees, cameraForward)
            : Quaternion.identity;

        float referenceDistance = Mathf.Max(0.0001f, Vector3.Distance(fineSamplePositions[0], cameraPosition));

        float phase = flowSpeed > 0f
            ? Mathf.Repeat(Time.time * flowSpeed, chevronSpacing)
            : 0f;

        int cursor = 0;
        float endBoundary = totalLength - endSkipDistance;

        for (int i = 0; i < ChevronCapacity; i++)
        {
            int vertexBase = i * VerticesPerChevron;

            if (i >= visibleCount)
            {
                CollapseChevron(vertexBase);
                continue;
            }

            float distance = startSkipDistance + i * chevronSpacing + phase;

            if (distance > endBoundary)
            {
                CollapseChevron(vertexBase);
                continue;
            }

            SampleAtDistance(distance, ref cursor, out Vector3 position, out Vector3 tangent);

            // Step 2: project the world tangent onto the camera's viewing plane.
            Vector3 screenTangent = Vector3.ProjectOnPlane(tangent, cameraForward);

            if (screenTangent.sqrMagnitude < 0.0001f)
            {
                screenTangent = Vector3.ProjectOnPlane(Vector3.up, cameraForward);

                if (screenTangent.sqrMagnitude < 0.0001f)
                {
                    screenTangent = cameraTransform.up;
                }
            }

            screenTangent.Normalize();

            // Steps 3-5: build the chevron entirely in the camera-facing plane (normal = camera.forward),
            // rotating in-plane (around camera.forward) so it follows the visible screen-space curve.
            Vector3 planeUp = rollCorrection * screenTangent;
            Vector3 planeRight = Vector3.Cross(cameraForward, planeUp).normalized;

            float distanceFromCamera = Vector3.Distance(position, cameraPosition);
            float perspectiveRatio = distanceFromCamera / referenceDistance;
            float sizeScale = Mathf.Lerp(1f, perspectiveRatio, PerspectiveCompensation);

            BuildChevronGeometry(vertexBase, position, planeUp, planeRight, chevronSize * sizeScale);
        }

        chevronMesh.SetVertices(chevronVertices);
        chevronMesh.RecalculateBounds();

        meshRenderer.enabled = true;
    }

    // Flat double-chevron ("V"/">" bracket) made of two thin stroke-quads meeting at a forward tip,
    // built purely from the shared in-plane axes (planeUp/planeRight) so it can never tilt sideways
    // or twist in 3D — every vertex lies exactly in the plane through 'position' with normal cameraForward.
    private void BuildChevronGeometry(int vertexBase, Vector3 position, Vector3 planeUp, Vector3 planeRight, float size)
    {
        float half = size * 0.5f;
        float armSpread = half * 0.85f;
        float armBackOffset = half * 0.75f;
        float thickness = size * 0.30f;

        Vector2 tip = new Vector2(0f, half);
        Vector2 right = new Vector2(armSpread, -armBackOffset);
        Vector2 left = new Vector2(-armSpread, -armBackOffset);

        BuildStrokeQuad(vertexBase, position, planeUp, planeRight, tip, right, thickness);
        BuildStrokeQuad(vertexBase + 4, position, planeUp, planeRight, tip, left, thickness);
    }

    private void BuildStrokeQuad(
        int vertexBase,
        Vector3 position,
        Vector3 planeUp,
        Vector3 planeRight,
        Vector2 fromLocal,
        Vector2 toLocal,
        float thickness)
    {
        Vector2 direction = (toLocal - fromLocal).normalized;
        Vector2 perpendicular = new Vector2(-direction.y, direction.x) * (thickness * 0.5f);

        Vector2 a = fromLocal + perpendicular;
        Vector2 b = fromLocal - perpendicular;
        Vector2 c = toLocal - perpendicular;
        Vector2 d = toLocal + perpendicular;

        chevronVertices[vertexBase + 0] = ToLocalMeshSpace(position, planeUp, planeRight, a);
        chevronVertices[vertexBase + 1] = ToLocalMeshSpace(position, planeUp, planeRight, b);
        chevronVertices[vertexBase + 2] = ToLocalMeshSpace(position, planeUp, planeRight, c);
        chevronVertices[vertexBase + 3] = ToLocalMeshSpace(position, planeUp, planeRight, d);
    }

    // Combines the camera-plane placement (world space) with the world-to-local mesh conversion
    // in one step. Mesh vertices are always local to this transform — never store raw world
    // positions here, or the whole trajectory offsets by however far this GameObject sits from
    // the world origin (see CHANGELOG "world/local mesh-space bug" entry).
    private Vector3 ToLocalMeshSpace(Vector3 worldCenter, Vector3 planeUp, Vector3 planeRight, Vector2 local)
    {
        Vector3 worldPoint = worldCenter + planeUp * local.y + planeRight * local.x;
        return transform.InverseTransformPoint(worldPoint);
    }

    private void CollapseChevron(int vertexBase)
    {
        // fineSamplePositions[0] is world space (throwOrigin.position at simulation time);
        // convert to local space like every other vertex, so RecalculateBounds() stays correct.
        Vector3 collapsePoint = transform.InverseTransformPoint(fineSamplePositions[0]);

        for (int i = 0; i < VerticesPerChevron; i++)
        {
            chevronVertices[vertexBase + i] = collapsePoint;
        }
    }

    private void HideTrajectory()
    {
        if (meshRenderer != null && meshRenderer.enabled)
        {
            meshRenderer.enabled = false;
        }
    }

    private void OnDestroy()
    {
        if (chevronMesh != null)
        {
            Destroy(chevronMesh);
        }
    }

    private void OnValidate()
    {
        maximumPointCount = Mathf.Max(10, maximumPointCount);
        maximumVisibleChevrons = Mathf.Clamp(maximumVisibleChevrons, 4, ChevronCapacity);

        // Deprecated field kept only for Inspector value compatibility; clamp so it's not flagged as unused.
#pragma warning disable CS0618
        tilesPerWorldUnit = Mathf.Max(0.1f, tilesPerWorldUnit);
#pragma warning restore CS0618

        if (Application.isPlaying)
        {
            fineSamplePositions = new Vector3[maximumPointCount];
            fineCumulativeDistance = new float[maximumPointCount];
            hasCachedSimulation = false;

            ApplyOpacity();
        }
    }
}
